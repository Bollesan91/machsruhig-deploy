  "spartipps": [
    {"titel": "Bestattungsart wählen", "text": "See- und Baumbestattungen sparen Friedhofsgebühren und Grabpflege. Ersparnis: 2.000–4.000 €."},
    {"titel": "Preise vergleichen", "text": "Die Stiftung Warentest empfiehlt, mindestens 3 Bestatter-Angebote einzuholen. Die Preisunterschiede sind erheblich."},
    {"titel": "Einfacher Sarg", "text": "Ein schlichter Holzsarg ab 300 € erfüllt denselben Zweck wie ein Premiummodell für 4.000 €."},
